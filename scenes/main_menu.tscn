theme_override_constants/line_spacing = 12
theme_override_fonts/font = ExtResource("9_jk1qb")
theme_override_font_sizes/font_size = 15
text = "Project IX combines strategic gameplay with an immersive sci-fi narrative. Players take on the role of Subject 009, a former hitman turned experimental weapon, navigating the ruins of a secret underground laboratory in the year 3015, a time when human technology has reached its peak.

The laboratory was abandoned after a failed experiment left unstable prototypes roaming its corridors. Reactivated by a power surge decades later, Subject 009 must survive against these rogue test subjects while collecting energy capsules to escape. The game emphasizes strategy, exploration, and quick decision-making, blending science fiction, mystery, and action.
"
horizontal_alignment = 1
autowrap_mode = 3

